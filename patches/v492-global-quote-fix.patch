+package ir.personal.chand.data
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class QuoteDisplayPolicyTest {
+    private val now = 1_800_000_000_000L
+    private fun descriptor(source: MarketSource, id: String = "gold_world") = MarketDescriptor(
+        id, "OANDA:XAUUSD", "Gold", "XAU/USD", "GOLD", source, "طلای جهانی", "دلار")
+    private fun quote(source: MarketSource, quoteAt: Long = now, receivedAt: Long = now,
+                      origin: DataOrigin = DataOrigin.NETWORK, id: String = "gold_world") = MarketItem(
+        id, "Gold", "XAU/USD", "GOLD", 4000.0, 10.0, 0.25,
+        4010.0, 3990.0, 4000.0, 4000.0, emptyList(), quoteAt, receivedAt,
+        origin, true, source, "طلای جهانی", "دلار", quoteAt)
+
+    @Test fun investingGlobalQuoteIsShownOnItsCard() {
+        assertTrue(QuoteDisplayPolicy.matches(descriptor(MarketSource.TRADINGVIEW),
+            quote(MarketSource.TRADINGVIEW)))
+    }
+
+    @Test fun domesticAndStocksStillVisibleWithCorrectSource() {
+        for (source in MarketSource.values()) {
+            assertTrue(QuoteDisplayPolicy.matches(descriptor(source), quote(source)))
+        }
+    }
+
+    @Test fun neverShowPriceFromUnrelatedProviderOrInstrument() {
+        assertFalse(QuoteDisplayPolicy.matches(descriptor(MarketSource.TGJU),
+            quote(MarketSource.TRADINGVIEW)))
+        assertFalse(QuoteDisplayPolicy.matches(descriptor(MarketSource.TRADINGVIEW),
+            quote(MarketSource.TRADINGVIEW, id = "other")))
+    }
+
+    @Test fun newerRealNetworkQuoteWinsEvenDuringLiveGrace() {
+        val current = quote(MarketSource.TRADINGVIEW, now - 6_000, now - 100, DataOrigin.LIVE)
+        val incoming = quote(MarketSource.TRADINGVIEW, now - 1_000, now)
+        assertTrue(QuoteDisplayPolicy.shouldReplace(current, incoming, now))
+        assertFalse(QuoteDisplayPolicy.shouldReplace(incoming, current, now))
+    }
+
+    @Test fun staleOrUnverifiedRestCannotReplaceVerifiedRecentTick() {
+        val current = quote(MarketSource.TRADINGVIEW, now - 10_000, now - 1_000, DataOrigin.LIVE)
+        val incoming = quote(MarketSource.TRADINGVIEW, 0L, now)
+        assertFalse(QuoteDisplayPolicy.shouldReplace(current, incoming, now))
+    }
+
+    @Test fun newQuoteCanReplaceOldUnverifiedCache() {
+        val current = quote(MarketSource.TRADINGVIEW, 0L, now - 60_000, DataOrigin.CACHE)
+        val incoming = quote(MarketSource.TRADINGVIEW, 0L, now)
+        assertTrue(QuoteDisplayPolicy.shouldReplace(current, incoming, now))
+    }
+}