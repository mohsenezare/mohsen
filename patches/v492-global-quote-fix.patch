+package ir.personal.chand.data
+
+/** Source-safe selection and reconciliation. Legacy TRADINGVIEW tag means Investing. */
+internal object QuoteDisplayPolicy {
+    fun matches(descriptor: MarketDescriptor, item: MarketItem): Boolean =
+        descriptor.id == item.id && descriptor.source == item.source &&
+            item.isAvailable && item.price.isFinite() && item.price > 0.0
+
+    fun shouldReplace(current: MarketItem?, incoming: MarketItem, now: Long): Boolean {
+        if (current == null || current.source != incoming.source) return true
+        val incomingQuote = incoming.liveQuoteAtMillis.takeIf { it > 0L }
+        val currentQuote = current.liveQuoteAtMillis.takeIf { it > 0L }
+        if (incomingQuote != null && currentQuote != null) {
+            // A provider timestamp outranks both origin and network-arrival time.
+            return incomingQuote >= currentQuote
+        }
+        if (incomingQuote != null) return true
+        if (currentQuote != null && currentQuote <= now && now - currentQuote <= 180_000L) {
+            // Unverified REST quotes cannot overwrite a recently verified trade.
+            return false
+        }
+        if (current.origin == DataOrigin.LIVE &&
+            current.receivedAtMillis > 0L && now - current.receivedAtMillis in 0L..5_000L) {
+            return false
+        }
+        return incoming.receivedAtMillis >= current.receivedAtMillis
+    }
+}
