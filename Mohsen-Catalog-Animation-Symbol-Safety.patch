@@ -0,0 +1,45 @@
+package ir.personal.chand.data
+
+import java.util.Locale
+
+/** A search result must identify the actual instrument, not merely mention its asset class. */
+internal object GlobalInstrumentMatch {
+    private val strictProducts = setOf(
+        "UKOIL", "USOIL", "XAUUSD", "XAGUSD", "BTCUSD", "ETHUSD",
+        "EURUSD", "GBPUSD", "USDJPY"
+    )
+
+    fun score(
+        sourceKey: String, symbol: String, fullName: String,
+        description: String, exchange: String
+    ): Int {
+        val expected = normalize(sourceKey.substringAfterLast(':'))
+        if (expected.isBlank()) return -1
+        val actual = normalize(symbol)
+        val full = normalize(fullName.substringAfterLast(':'))
+        val preferredExchange = sourceKey.substringBefore(':', "").uppercase(Locale.US)
+        val actualExchange = exchange.trim().uppercase(Locale.US)
+        val exact = actual == expected || full == expected
+        if (!exact) return -1
+
+        // CFD Brent UKOIL must never be silently replaced by WTI, an ICE
+        // futures contract, a dated expiry or an unrelated crude oil quote.
+        val desc = description.lowercase(Locale.US)
+        if (expected == "UKOIL" &&
+            (desc.contains("wti") || desc.contains("west texas") ||
+                actual == "USOIL" || full == "USOIL")) return -1
+        if (expected == "USOIL" &&
+            (desc.contains("brent") || actual == "UKOIL" || full == "UKOIL")) return -1
+
+        // For the built-in products, the data feed/exchange is part of identity.
+        // A similarly named instrument on another venue may have a different price.
+        if (expected in strictProducts && preferredExchange.isNotBlank() &&
+            actualExchange.isNotBlank() && !preferredExchange.equals(actualExchange, true) &&
+            !fullName.startsWith("$preferredExchange:", true)) return -1
+        return 200 + if (preferredExchange.isNotBlank() &&
+            actualExchange == preferredExchange) 40 else 0
+    }
+
+    private fun normalize(value: String): String = value.uppercase(Locale.US)
+        .filter(Char::isLetterOrDigit)
+}
