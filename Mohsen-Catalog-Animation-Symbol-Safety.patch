@@ -0,0 +1,23 @@
+package ir.personal.chand.data
+
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class GlobalInstrumentMatchTest {
+    @Test fun brentCFDMatchesItsOwnExchangeAndTicker() {
+        assertTrue(GlobalInstrumentMatch.score("TVC:UKOIL", "UKOIL", "TVC:UKOIL", "Brent crude oil", "TVC") > 0)
+    }
+    @Test fun brentNeverMatchesWtiEvenIfSearchDescriptionSaysOil() {
+        assertTrue(GlobalInstrumentMatch.score("TVC:UKOIL", "USOIL", "TVC:USOIL", "WTI crude oil", "TVC") < 0)
+    }
+    @Test fun brentNeverMatchesSameNameOnDifferentExchange() {
+        assertTrue(GlobalInstrumentMatch.score("TVC:UKOIL", "UKOIL", "BROKER:UKOIL", "Brent", "BROKER") < 0)
+    }
+    @Test fun brentDoesNotSilentlySwitchToIceFutures() {
+        assertTrue(GlobalInstrumentMatch.score("TVC:UKOIL", "BRN1!", "ICEEUR:BRN1!", "Brent Futures", "ICEEUR") < 0)
+    }
+    @Test fun fxSymbolMustMatchPair() {
+        assertTrue(GlobalInstrumentMatch.score("FX:EURUSD", "GBPUSD", "FX:GBPUSD", "FX quote", "FX") < 0)
+        assertTrue(GlobalInstrumentMatch.score("FX:EURUSD", "EURUSD", "FX:EURUSD", "Euro Dollar", "FX") > 0)
+    }
+}
