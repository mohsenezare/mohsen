+/**
+ * Compact mode only. One flat, short row with deterministic RTL column order:
+ * [symbol/logo + name] [LIVE] [percent] [absolute delta + direction] [price].
+ * Never shrinks the normal list/grid cards or their typography.
+ */
+@Composable
+private fun CompactQuoteRow(
+    item: MarketItem,
+    modifier: Modifier = Modifier,
+    onClick: () -> Unit
+) {
+    val lightMode = MaterialTheme.colorScheme.background.luminance() > 0.5f
+    val primaryText = if (lightMode) Color(0xFF17191C) else Color(0xFFF4F5F6)
+    val mutedText = if (lightMode) Color(0xFF7F8289) else ChandMuted
+    val priceText = MarketFormatting.price(item)
+    val direction = when {
+        !item.isAvailable || item.change == 0.0 -> ""
+        item.change > 0.0 -> "↑"
+        else -> "↓"
+    }
+    val absoluteChange = MarketFormatting.change(item).removePrefix("↑").removePrefix("↓")
+    Card(
+        onClick = onClick,
+        modifier = modifier,
+        shape = RoundedCornerShape(14.dp),
+        colors = CardDefaults.cardColors(
+            containerColor = if (lightMode) Color(0xFFFDFDFC) else ChandCard
+        ),
+        elevation = CardDefaults.cardElevation(defaultElevation = if (lightMode) 4.dp else 0.dp)
+    ) {
+        BoxWithConstraints(modifier = Modifier.fillMaxSize()) {
+            val narrow = maxWidth < 345.dp
+            val logoSize = if (narrow) 27.dp else 30.dp
+            val fixedGap = if (narrow) 3.dp else 5.dp
+            androidx.compose.runtime.CompositionLocalProvider(
+                androidx.compose.ui.platform.LocalLayoutDirection provides androidx.compose.ui.unit.LayoutDirection.Rtl
+            ) {
+                Row(
+                    modifier = Modifier.fillMaxSize().padding(horizontal = if (narrow) 7.dp else 10.dp, vertical = 7.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.spacedBy(fixedGap)
+                ) {
+                    // Identity right: logo + Persian name and ticker code.
+                    Row(
+                        modifier = Modifier.weight(1.18f),
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.spacedBy(4.dp)
+                    ) {
+                        // Avoid logo-network lookups before the first valid quote.
+                        if (!item.isAvailable || item.origin == DataOrigin.CACHE) {
+                            SymbolSpecificFallbackBadge(item, Modifier.size(logoSize))
+                        } else {
+                            MarketCardBadge(item, Modifier.size(logoSize), denseMode = false)
+                        }
+                        Column(
+                            modifier = Modifier.weight(1f),
+                            verticalArrangement = Arrangement.spacedBy(2.dp)
+                        ) {
+                            Text(
+                                text = item.name,
+                                color = primaryText,
+                                fontWeight = FontWeight.Bold,
+                                fontSize = if (narrow) 10.sp else 11.sp,
+                                lineHeight = 13.sp,
+                                maxLines = 1,
+                                overflow = TextOverflow.Ellipsis
+                            )
+                            Text(
+                                text = item.code,
+                                color = mutedText,
+                                fontWeight = FontWeight.Medium,
+                                fontSize = if (narrow) 8.sp else 9.sp,
+                                lineHeight = 10.sp,
+                                maxLines = 1,
+                                overflow = TextOverflow.Ellipsis
+                            )
+                        }
+                    }
+                    // LIVE is exactly the existing emerald session badge and logic.
+                    Box(modifier = Modifier.width(if (narrow) 30.dp else 33.dp), contentAlignment = Alignment.Center) {
+                        MarketStatusLabel(item, compact = true)
+                    }
+                    // Consistent numeric columns, no visual jumping between updates.
+                    Box(modifier = Modifier.width(if (narrow) 44.dp else 48.dp), contentAlignment = Alignment.Center) {
+                        Text(
+                            text = compactPercent(item),
+                            color = percentColor(item),
+                            fontSize = if (narrow) 9.sp else 10.sp,
+                            fontWeight = FontWeight.Bold,
+                            maxLines = 1,
+                            softWrap = false
                         )
-                    },
-                onClick = { onItemClick(item) }
-            )
+                    }
+                    Row(
+                        modifier = Modifier.width(if (narrow) 55.dp else 62.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.Center
+                    ) {
+                        Text(
+                            text = direction,
+                            color = trendColor(item),
+                            fontSize = 13.sp,
+                            fontWeight = FontWeight.Black,
+                            maxLines = 1
+                        )
+                        Text(
+                            text = absoluteChange,
+                            color = trendColor(item),
+                            fontSize = if (narrow || absoluteChange.length > 7) 9.sp else 10.sp,
+                            fontWeight = FontWeight.SemiBold,
+                            maxLines = 1,
+                            softWrap = false,
+                            overflow = TextOverflow.Ellipsis
+                        )
+                    }
+                    Box(modifier = Modifier.weight(1.10f), contentAlignment = Alignment.CenterEnd) {
+                        Text(
+                            text = priceText,
+                            color = if (item.isAvailable) primaryText else mutedText,
+                            fontSize = when {
+                                priceText.length >= 15 -> 10.sp
+                                priceText.length >= 11 -> 11.sp
+                                narrow -> 12.sp
+                                else -> 14.sp
+                            },
+                            fontWeight = FontWeight.Black,
+                            lineHeight = 15.sp,
+                            maxLines = 1,
+                            softWrap = false,
+                            overflow = TextOverflow.Ellipsis
+                        )
+                    }
+                }
+            }
         }
     }
 }
